# Copy to .env (repo root) for docker compose. Never commit the real file.
TOKEN_KEY=<generate with: openssl rand -hex 32>
COSMOS_CONNECTION_STRING=mongodb://mongouser:<password>@mongo:27017/calendar-db?authSource=admin
# generate with: npm --prefix backend run hash-password -- <username> <password>
# use the "production" block it prints (already $-escaped for docker compose)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$$2b$$12$$<bcrypt hash>
MONGO_INITDB_ROOT_USERNAME=mongouser
MONGO_INITDB_ROOT_PASSWORD=<strong password matching COSMOS_CONNECTION_STRING>
